NB. ==============================================================================
NB. Albedo - ENVI Hyperspectral Image & Header I/O
NB.
NB. Implements ENVI (.hdr) metadata parser and serializer, format validation,
NB. and interleave transformations between BSQ, BIL, and BIP storage layouts.
NB. ==============================================================================

cocurrent 'base'

NB. ------------------------------------------------------------------------------
NB. Interleave Transformations
NB.
NB. BSQ (Band Sequential):           (B, H, W)
NB. BIL (Band Interleaved by Line):   (H, B, W)
NB. BIP (Band Interleaved by Pixel):  (H, W, B)
NB. ------------------------------------------------------------------------------

NB. Convert BSQ (B, H, W) to BIL (H, B, W)
bsq_to_bil=: 1 0 2&|:

NB. Convert BIL (H, B, W) to BSQ (B, H, W)
bil_to_bsq=: 1 0 2&|:

NB. Convert BSQ (B, H, W) to BIP (H, W, B)
bsq_to_bip=: 1 2 0&|:

NB. Convert BIP (H, W, B) to BSQ (B, H, W)
bip_to_bsq=: 2 0 1&|:

NB. Convert BIL (H, B, W) to BIP (H, W, B)
bil_to_bip=: 0 2 1&|:

NB. Convert BIP (H, W, B) to BIL (H, B, W)
bip_to_bil=: 0 2 1&|:

NB. ------------------------------------------------------------------------------
NB. ENVI Header Parsing
NB. ------------------------------------------------------------------------------

NB. Helper to trim leading/trailing whitespace
trim=: 3 : 0
  s=. y
  m=. -. s e. ' ', (9 10 13 { a.)
  if. 0 = +/ m do. '' return. end.
  first=. m i. 1
  last=. (#s) - (|. m) i. 1
  first }. last {. s
)

NB. Parse a single key-value line from ENVI header text
NB. e.g. "samples = 512" -> ('samples'; '512')
parse_header_line=: 3 : 0
  line=. trim y
  if. (0 = # line) +. (';' = {. line) do. ''; '' return. end.
  idx=. line i. '='
  if. idx = # line do.
    (trim line); ''
  else.
    k=. trim idx {. line
    v=. trim (idx + 1) }. line
    k; v
  end.
)

NB. Parse numeric vector from string like "{400.5, 410.2, 420.0}" or "400.5, 410.2"
parse_num_list=: 3 : 0
  str=. y -. '{}'
  NB. Replace commas with spaces
  str=. ' ' (I. str = ',')} str
  NB. Convert to numbers
  0 ". str
)

NB. Parse full ENVI header string
NB. Returns boxed key-value dictionary table
parse_envi_header=: 3 : 0
  raw_text=. y
  lines=. <;._2 raw_text , (LF -. {: raw_text)
  
  NB. Validate ENVI header magic
  assert. 'ENVI' -: trim > {. lines [ 'Missing ENVI magic header line'

  keys=. 0 $ <''
  vals=. 0 $ <''

  in_brace=. 0
  curr_key=. ''
  curr_val=. ''

  for_i. 1 }. i. # lines do.
    line=. trim > i { lines
    if. (0 = # line) +. (';' = {. line) do. continue. end.

    if. in_brace do.
      curr_val=. curr_val, ' ', line
      if. '}' e. line do.
        in_brace=. 0
        keys=. keys , < curr_key
        vals=. vals , < curr_val
      end.
    else.
      'k v'=. parse_header_line line
      if. '{' e. v do.
        if. '}' e. v do.
          keys=. keys , < k
          vals=. vals , < v
        else.
          in_brace=. 1
          curr_key=. k
          curr_val=. v
        end.
      else.
        if. 0 < # k do.
          keys=. keys , < k
          vals=. vals , < v
        end.
      end.
    end.
  end.

  keys ,: vals
)

NB. Helper to convert string to lowercase
tolower=: 3 : 0
  c=. y
  uc=. (65 + i. 26) { a.
  lc=. (97 + i. 26) { a.
  idx=. uc i. c
  mask=. idx < 26
  res=. c
  if. +/ mask do.
    pos=. I. mask
    res=. ((pos { idx) { lc) pos } res
  end.
  res
)

NB. Lookup value in parsed header dictionary table
NB. Dyadic: key get_header_field header_dict
get_header_field=: 4 : 0
  k_query=. tolower x
  keys=. 0 { y
  vals=. 1 { y
  low_keys=. tolower each keys
  idx=. low_keys i. < k_query
  if. idx < # keys do.
    > idx { vals
  else.
    ''
  end.
)

NB. ------------------------------------------------------------------------------
NB. ENVI Header Serialization
NB. ------------------------------------------------------------------------------

NB. Format numeric list into ENVI bracketed string
format_num_list=: 3 : 0
  nums=. y
  if. 0 = # nums do. '{}' return. end.
  strs=. ": each nums
  res=. > 0 { strs
  for_idx. 1 }. i. # strs do.
    res=. res, ', ', > idx { strs
  end.
  '{', res, '}'
)

NB. Generate ENVI header string from metadata fields:
NB. (samples; lines; bands; data_type; interleave; byte_order; wavelengths; fwhm)
generate_envi_header=: 3 : 0
  'samples lines bands data_type interleave byte_order wvl fwhm'=. y
  out=. 'ENVI', LF
  out=. out, 'description = {Generated by Albedo Hyperspectral Processing Engine}', LF
  out=. out, 'samples = ', (": samples), LF
  out=. out, 'lines   = ', (": lines), LF
  out=. out, 'bands   = ', (": bands), LF
  out=. out, 'header offset = 0', LF
  out=. out, 'file type = ENVI Standard', LF
  out=. out, 'data type = ', (": data_type), LF
  out=. out, 'interleave = ', interleave, LF
  out=. out, 'sensor type = Unknown', LF
  out=. out, 'byte order = ', (": byte_order), LF
  out=. out, 'wavelength units = Nanometers', LF

  if. 0 < # wvl do.
    out=. out, 'wavelength = ', (format_num_list wvl), LF
  end.
  if. 0 < # fwhm do.
    out=. out, 'fwhm = ', (format_num_list fwhm), LF
  end.
  out
)


albedo_envi_parse_envi_header =: parse_envi_header
albedo_envi_generate_envi_header =: generate_envi_header
albedo_envi_get_header_field =: get_header_field
albedo_envi_parse_num_list =: parse_num_list
albedo_envi_bsq_to_bil =: bsq_to_bil
albedo_envi_bil_to_bsq =: bil_to_bsq
albedo_envi_bsq_to_bip =: bsq_to_bip
albedo_envi_bip_to_bsq =: bip_to_bsq
